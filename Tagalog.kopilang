klase NewComp
{
    publiko estatiko wala pangunahin (teksto [] args)
    {
        lutang X1,Y1;
        numero I, J, K;
        
        X1=0;
        Y1=10; 
        K=10;
        J=-10;
        
        {
            para (I=1; I+10<=K; I=I-1)
            habang (K+I<20)
            {
                J=I; 
                
                gawin
                {
                    kung (X1>Y1)
                        J=J-2;
                    kundi
                        J=J/4;
                        
                    X1=X1*2.0;
                }
                habang (J>=20);
                
                K=K+3;
            }
        }
    }
}