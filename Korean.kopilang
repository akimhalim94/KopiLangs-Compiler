keullaeseu NewComp
{
    gonggae jeongjeok bin mein (munjayeol [] args)
    {
        silsu X1,Y1;
        jeongsu I, J, K;
        
        X1=0;
        Y1=10; 
        K=10;
        J=-10;
        
        {
            wihae (I=1; I+10<=K; I=I-1)
            dongan (K+I<20)
            {
                J=I; 
                
                hada
                {
                    manyag (X1>Y1)
                        J=J-2;
                    animyeon
                        J=J/4;
                        
                    X1=X1*2.0;
                }
                dongan (J>=20);
                
                K=K+3;
            }
        }
    }
}